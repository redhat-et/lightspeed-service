# Copy to judges.env and fill in. judges.env is gitignored — keep it that way.
# Every value here is specific to your environment; nothing is hardcoded in the
# template or the renderer.

# --- judge endpoint -------------------------------------------------------
# OpenAI-compatible base URL, including /v1.
JUDGE_API_BASE=https://your-openai-compatible-endpoint.example/v1
JUDGE_API_KEY=

# --- judges ---------------------------------------------------------------
# Three judges from three different families. The model names below are the ones
# the published numbers were scored with; replace them with your provider's ids
# (keep the openai/ prefix, it is how the harness routes through the gateway).
JUDGE_1_MODEL=openai/gpt-5.4
JUDGE_1_MAX_TOKENS=1000
JUDGE_2_MODEL=openai/glm-5-3
JUDGE_2_MAX_TOKENS=4096
JUDGE_3_MODEL=openai/DeepSeek-V4.1-Flash-1017
JUDGE_3_MAX_TOKENS=4096

# --- system under test ----------------------------------------------------
# The route the app is reached on, and the provider/model the harness asks for.
# APP_PROVIDER and APP_MODEL must name an entry that exists in olsconfig.yaml:
#   - CPU arm: your CPU-hosted model (type rhoai_vllm or similar)
#   - GPU arm: an openai-type provider pointed at your GPU writer endpoint
APP_API_BASE=https://your-ols-endpoint.example
APP_PROVIDER=cpu-writer
APP_MODEL=your-cpu-model
