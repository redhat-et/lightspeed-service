# Copy to judges.env and fill in. judges.env is gitignored — keep it that way.
# Every value here is specific to your environment; nothing is hardcoded in the
# template or the renderer.

# --- judge endpoint -------------------------------------------------------
# OpenAI-compatible base URL, including /v1.
JUDGE_API_BASE=https://your-openai-compatible-endpoint.example/v1
JUDGE_API_KEY=

# --- judges ---------------------------------------------------------------
# Three judges, ideally from three different families. Replace each model id
# with one your endpoint actually serves.
#
# Keep the openai/ prefix on the value: it selects the OpenAI-compatible route
# through the harness's gateway. It is not part of the model name, and the
# harness will not route the call without it.
#
# Do not collapse this to a single judge. On identical answers one judge moved
# 24 of 95 per-question scores and flipped a question on noise alone; the
# per-question spread between judges has a median near 0.10. A one-judge delta
# under roughly 5 PASS at n = 100 is not a result.
JUDGE_1_MODEL=openai/your-judge-model-1
JUDGE_1_MAX_TOKENS=1000
JUDGE_2_MODEL=openai/your-judge-model-2
JUDGE_2_MAX_TOKENS=4096
JUDGE_3_MODEL=openai/your-judge-model-3
JUDGE_3_MAX_TOKENS=4096

# --- system under test ----------------------------------------------------
# The route the app is reached on, and the provider/model the harness asks for.
# On this branch the request names the *CPU* model: it runs the tool round. The
# model that writes the final answer is selected server-side by
# ols_config.synthesis_llm (see olsconfig.hybrid.example.yaml), not here.
APP_API_BASE=https://your-ols-endpoint.example
APP_PROVIDER=your-cpu-provider
APP_MODEL=your-cpu-model
